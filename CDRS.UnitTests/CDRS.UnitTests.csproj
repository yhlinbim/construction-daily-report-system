    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CDRS.Domain\CDRS.Domain.csproj" />
    <ProjectReference Include="..\CDRS.Application\CDRS.Application.csproj" />
    <ProjectReference Include="..\CDRS.Infrastructure\CDRS.Infrastructure.csproj" />
    <ProjectReference Include="..\CDRS.Web\CDRS.Web.csproj" />
