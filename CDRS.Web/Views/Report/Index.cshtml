@model List<CDRS.Domain.Entities.DailyReport>
@{
    ViewData["Title"] = "Daily Reports";
    var projectId = ViewBag.ProjectId as string;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Daily Reports — Project @projectId</h2>
        <a asp-action="Create" asp-route-projectId="@projectId" class="btn btn-primary">
            + New Report
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
            <div class="alert alert-success">@TempData["Success"]</div>
    }

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Worker</th>
                <th>Description</th>
                <th>Workers on Site</th>
                <th>Weather</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var report in Model)
            {
                    <tr>
                        <td>@report.ReportDate.ToString("yyyy-MM-dd")</td>
                        <td>@report.SiteWorkerId</td>
                        <td>@report.WorkDescription</td>
                        <td>@report.WorkerCount</td>
                        <td>@report.WeatherCondition</td>
                        <td>
                            <span class="badge bg-@GetStatusColor(report.Status)">
                            @report.Status
                            </span>
                        </td>
                        <td>
                        @if (report.Status == CDRS.Domain.Enums.ReportStatus.Draft)
                        {
                                    <form asp-action="Submit" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@report.Id" />
                                        <input type="hidden" name="projectId" value="@projectId" />
                                @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-primary">
                                            Submit
                                        </button>
                                    </form>
                        }
                        </td>
                    </tr>
            }
        </tbody>
    </table>
</div>

@functions {
    string GetStatusColor(CDRS.Domain.Enums.ReportStatus status) => status switch
    {
        CDRS.Domain.Enums.ReportStatus.Draft => "secondary",
        CDRS.Domain.Enums.ReportStatus.Submitted => "info",
        CDRS.Domain.Enums.ReportStatus.UnderReview => "warning",
        CDRS.Domain.Enums.ReportStatus.Approved => "success",
        CDRS.Domain.Enums.ReportStatus.Rejected => "danger",
        _ => "secondary"
    };
}
